<?xml version="1.1" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<!--Gatter/Setter Use !-->

	<!-- Inner Bean -->
	<bean name="emp1" class="learning.spring.model.Employee">

		<property name="id" value="1011" />
		<property name="name" value="Anu" />
		<property name="gender" value="Male" />
		<property name="address">

			<bean class="learning.spring.model.Address">
				<property name="city" value="Puna" />
				<property name="state" value="MH"/>

			</bean>

		</property>

	</bean>

</beans>