<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<!--Gatter/Setter Use !-->

	<bean name="add1" class="learning.spring.model.Address">
		<property name="city" value="puna" />
		<property name="state" value="Maharashtra" />
	</bean>


	<bean name="emp1" class="learning.spring.model.Employee">

		<property name="id" value="1011" />
		<property name="name" value="Anu" />
		<property name="gender" value="Male" />
		<property name="address" ref="add1" />

	</bean>


	<!--Constructore Use ! -->

	<bean name="add2" class="learning.spring.model.Address">
		<property name="city" value="Noida" />
		<property name="state" value="UP" />
	</bean>


	<bean name="emp2" class="learning.spring.model.Employee">

		<constructor-arg name="id" value="222" />
		<constructor-arg name="name" value="Ashish" />
		<constructor-arg name="gender" value="Male" />
		<constructor-arg name="address" ref="add2" />

	</bean>


</beans>