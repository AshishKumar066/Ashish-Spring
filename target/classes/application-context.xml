<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

	<!-- bean definitions here -->
	<!--Gatter/Setter Use !-->

	<bean name="address" class="learning.spring.model.Address">
		<property name="city" value="puna" />
		<property name="state" value="Maharashtra" />
	</bean>


	<bean name="emp1" class="learning.spring.model.Employee" init-method="xmlInitMethod" destroy-method="xmlDestroyMethod" autowire="byName">

		<property name="id" value="1011" />
		<property name="name" value="Anu" />
		<property name="gender" value="Male" />

	</bean>

</beans>